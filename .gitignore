# SQL dump di root repo — mysqldump manual (apayalupa.sql, ftth_devices_Fri4Sep2026.sql,
# prod_db.sql, dst) selalu muncul dengan nama ad-hoc yang tak mungkin dikejar
# satu per satu, dan isinya PII pelanggan asli + hash password akun sungguhan.
# Blokir SEMUA *.sql di root (pola root-only, tanpa **), lalu izinkan eksplisit
# yang memang bagian dari source. Migrasi/seed asli tetap di scripts/ — tidak
# kena aturan ini karena scripts/ bukan root.
/*.sql
!/schema.sql

