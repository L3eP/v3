# ============================================================
# Environment Configuration — MAYUNG Ticketing System
# Copy this file to .env and adjust values for your environment
# ============================================================

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=login_app_user
DB_PASSWORD=strongpassword
DB_NAME=login_app_db

# Server
PORT=3000
SESSION_SECRET=change_this_secret_key

# Fonnte WhatsApp Notification
# Daftar di https://fonnte.com dan dapatkan token dari dashboard
FONNTE_TOKEN=your_fonnte_token_here

# Base URL publik aplikasi ini (TANPA trailing slash) — dipakai untuk menyusun
# link tiket di notifikasi WhatsApp (mis. https://mayung.example.com/ticket-details.html?id=123).
# WAJIB diisi ke domain publik yang sesungguhnya di production — kalau kosong,
# notification.js fallback ke http://localhost:<PORT> dan link di WA jadi tidak
# bisa dibuka penerima.
APP_URL=http://localhost:3000

# Environment (development / production / staging)
NODE_ENV=development

# Set to "false" only if Node is directly internet-facing with NO reverse proxy
# in front of it (nginx/etc). Default (unset/anything else) trusts one hop of
# X-Forwarded-* — required for rate limiting and audit IPs to work correctly
# behind a reverse proxy.
TRUST_PROXY=
